[Unit]
Description=gdsync - Google Drive en tu gestor de archivos
After=network-online.target
Wants=network-online.target

[Service]
ExecStart=%h/.local/bin/gdsyncd
Restart=on-failure
RestartSec=10
ExecStopPost=-/bin/sh -c 'M=$(grep -m1 mount_point "${XDG_CONFIG_HOME:-$HOME/.config}/gdsync/config.json" 2>/dev/null | sed -e "s/^[^:]*:[[:space:]]*//" -e "s/,[[:space:]]*$//" -e "s/^.//" -e "s/.$//"); fusermount3 -uz "${M:-$HOME/GoogleDrive}" 2>/dev/null || true'

[Install]
WantedBy=default.target
