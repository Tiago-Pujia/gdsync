import { Theme } from "../theme.slint";

export component Toast inherits Rectangle {
    in property <string> title: "Notificación";
    in property <string> message: "Operación realizada con éxito.";
    in property <bool> is-warning: false;
    callback close();

    width: 320px;
    background: Theme.bg-card;
    border-radius: Theme.radius-md;
    border-width: 1px;
    border-color: Theme.border-color;

    // Left colored accent line
    Rectangle {
        x: 0;
        y: 0;
        width: 4px;
        height: parent.height;
        border-radius: 2px;
        background: root.is-warning ? Theme.warning : Theme.accent;
    }

    HorizontalLayout {
        padding-left: 14px;
        padding-right: 12px;
        padding-top: 10px;
        padding-bottom: 10px;
        alignment: space-between;
        spacing: 10px;

        VerticalLayout {
            spacing: 2px;
            Text {
                text: root.title;
                font-size: 13px;
                font-weight: 700;
                color: Theme.text-main;
            }
            Text {
                text: root.message;
                font-size: 12px;
                color: Theme.text-secondary;
                wrap: word-wrap;
            }
        }

        Rectangle {
            width: 20px;
            height: 20px;
            y: 0;
            Text {
                text: "✕";
                font-size: 12px;
                color: Theme.text-muted;
                vertical-alignment: center;
                horizontal-alignment: center;
            }
            TouchArea {
                clicked => { root.close(); }
            }
        }
    }
}
