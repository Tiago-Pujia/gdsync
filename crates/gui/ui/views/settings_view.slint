import { Theme } from "../theme.slint";
import { SwitchToggle } from "../components/switch_toggle.slint";
import { ScrollView } from "std-widgets.slint";

export component SettingsView inherits VerticalLayout {
    in-out property <string> mount-point: "/home/tiago/GoogleDrive";
    in-out property <string> cache-size-gb: "10";
    in-out property <string> poll-interval-secs: "30";
    in-out property <bool> autostart-gui: true;
    in-out property <bool> autostart-daemon: true;
    in-out property <bool> notify-enabled: true;
    in-out property <bool> resident-notify: true;
    in-out property <bool> close-to-tray: true;

    callback browse-mount-point();
    callback save-settings();
    callback confirm-resync();

    spacing: 16px;
    padding: 24px;

    // View Header
    HorizontalLayout {
        alignment: space-between;
        VerticalLayout {
            spacing: 4px;
            Text {
                text: "Preferencias del Sistema";
                font-size: 20px;
                font-weight: 700;
                color: Theme.text-main;
            }
            Text {
                text: "Ajustes de rendimiento, puntos de montaje y comportamiento de fondo.";
                font-size: 13px;
                color: Theme.text-secondary;
            }
        }

        Rectangle {
            border-radius: Theme.radius-sm;
            background: touch_save.has-hover ? Theme.accent-hover : Theme.accent;
            height: 32px;
            HorizontalLayout {
                padding-left: 14px;
                padding-right: 14px;
                Text {
                    text: "Guardar Cambios";
                    font-size: 12px;
                    font-weight: 600;
                    color: white;
                    vertical-alignment: center;
                    horizontal-alignment: center;
                }
            }
            touch_save := TouchArea {
                mouse-cursor: pointer;
                clicked => { root.save-settings(); }
            }
        }
    }

    ScrollView {
        VerticalLayout {
            alignment: start;
            spacing: 16px;

            // Mount Point Card
            Rectangle {
                background: Theme.bg-card;
                border-radius: Theme.radius-lg;
                border-width: 1px;
                border-color: Theme.border-color;

                VerticalLayout {
                    padding: 20px;
                    spacing: 12px;

                    HorizontalLayout {
                        spacing: 8px;
                        alignment: start;
                        Text { text: "📂"; font-size: 15px; vertical-alignment: center; }
                        Text {
                            text: "Directorio de Montaje";
                            font-size: 14px;
                            font-weight: 600;
                            color: Theme.text-main;
                            vertical-alignment: center;
                        }
                    }

                    VerticalLayout {
                        spacing: 6px;
                        Text {
                            text: "Punto de montaje local (FUSE):";
                            font-size: 12px;
                            font-weight: 600;
                            color: Theme.text-secondary;
                        }
                        HorizontalLayout {
                            spacing: 8px;
                            Rectangle {
                                height: 34px;
                                background: Theme.bg-surface;
                                border-radius: Theme.radius-sm;
                                border-width: 1px;
                                border-color: Theme.border-color;
                                horizontal-stretch: 1;

                                HorizontalLayout {
                                    padding-left: 10px;
                                    padding-right: 10px;
                                    TextInput {
                                        text <=> root.mount-point;
                                        font-size: 12px;
                                        color: Theme.text-main;
                                        vertical-alignment: center;
                                    }
                                }
                            }

                            Rectangle {
                                border-radius: Theme.radius-sm;
                                background: touch_browse.has-hover ? Theme.bg-surface-hover : Theme.bg-surface;
                                border-width: 1px;
                                border-color: touch_browse.has-hover ? #ffffff2e : Theme.border-color;
                                height: 34px;
                                HorizontalLayout {
                                    padding-left: 12px;
                                    padding-right: 12px;
                                    Text {
                                        text: "Examinar...";
                                        font-size: 12px;
                                        font-weight: 500;
                                        color: touch_browse.has-hover ? Theme.text-main : Theme.text-secondary;
                                        vertical-alignment: center;
                                    }
                                }
                                touch_browse := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => { root.browse-mount-point(); }
                                }
                            }
                        }
                    }
                }
            }

            // Performance & Cache Card
            Rectangle {
                background: Theme.bg-card;
                border-radius: Theme.radius-lg;
                border-width: 1px;
                border-color: Theme.border-color;

                VerticalLayout {
                    padding: 20px;
                    spacing: 16px;

                    HorizontalLayout {
                        spacing: 8px;
                        alignment: start;
                        Text { text: "⚡"; font-size: 15px; vertical-alignment: center; }
                        Text {
                            text: "Rendimiento & Caché";
                            font-size: 14px;
                            font-weight: 600;
                            color: Theme.text-main;
                            vertical-alignment: center;
                        }
                    }

                    HorizontalLayout {
                        alignment: space-between;
                        VerticalLayout {
                            spacing: 2px;
                            Text {
                                text: "Límite máximo de caché local:";
                                font-size: 13px;
                                font-weight: 500;
                                color: Theme.text-main;
                            }
                            Text {
                                text: "Espacio en disco para almacenar archivos abiertos recientemente";
                                font-size: 12px;
                                color: Theme.text-secondary;
                            }
                        }

                        HorizontalLayout {
                            spacing: 6px;
                            Rectangle {
                                width: 70px;
                                height: 30px;
                                background: Theme.bg-surface;
                                border-radius: Theme.radius-sm;
                                border-width: 1px;
                                border-color: Theme.border-color;

                                HorizontalLayout {
                                    padding-left: 8px;
                                    padding-right: 8px;
                                    TextInput {
                                        text <=> root.cache-size-gb;
                                        font-size: 12px;
                                        color: Theme.text-main;
                                        vertical-alignment: center;
                                        horizontal-alignment: center;
                                    }
                                }
                            }
                            Text {
                                text: "GB";
                                font-size: 12px;
                                font-weight: 600;
                                color: Theme.text-secondary;
                                vertical-alignment: center;
                            }
                        }
                    }

                    HorizontalLayout {
                        alignment: space-between;
                        VerticalLayout {
                            spacing: 2px;
                            Text {
                                text: "Frecuencia de sondeo remoto:";
                                font-size: 13px;
                                font-weight: 500;
                                color: Theme.text-main;
                            }
                            Text {
                                text: "Intervalo para consultar cambios en Google Drive";
                                font-size: 12px;
                                color: Theme.text-secondary;
                            }
                        }

                        HorizontalLayout {
                            spacing: 6px;
                            Rectangle {
                                width: 70px;
                                height: 30px;
                                background: Theme.bg-surface;
                                border-radius: Theme.radius-sm;
                                border-width: 1px;
                                border-color: Theme.border-color;

                                HorizontalLayout {
                                    padding-left: 8px;
                                    padding-right: 8px;
                                    TextInput {
                                        text <=> root.poll-interval-secs;
                                        font-size: 12px;
                                        color: Theme.text-main;
                                        vertical-alignment: center;
                                        horizontal-alignment: center;
                                    }
                                }
                            }
                            Text {
                                text: "seg";
                                font-size: 12px;
                                font-weight: 600;
                                color: Theme.text-secondary;
                                vertical-alignment: center;
                            }
                        }
                    }
                }
            }

            // Desktop Integration Card
            Rectangle {
                background: Theme.bg-card;
                border-radius: Theme.radius-lg;
                border-width: 1px;
                border-color: Theme.border-color;

                VerticalLayout {
                    padding: 20px;
                    spacing: 16px;

                    HorizontalLayout {
                        spacing: 8px;
                        alignment: start;
                        Text { text: "🖥️"; font-size: 15px; vertical-alignment: center; }
                        Text {
                            text: "Integración con el Escritorio";
                            font-size: 14px;
                            font-weight: 600;
                            color: Theme.text-main;
                            vertical-alignment: center;
                        }
                    }

                    HorizontalLayout {
                        alignment: space-between;
                        VerticalLayout {
                            spacing: 2px;
                            Text {
                                text: "Iniciar aplicación con el sistema (Bandeja)";
                                font-size: 13px;
                                font-weight: 500;
                                color: Theme.text-main;
                            }
                            Text {
                                text: "La interfaz gráfica se abre minimizada al iniciar sesión en el escritorio";
                                font-size: 12px;
                                color: Theme.text-secondary;
                            }
                        }
                        SwitchToggle {
                            checked <=> root.autostart-gui;
                        }
                    }

                    HorizontalLayout {
                        alignment: space-between;
                        VerticalLayout {
                            spacing: 2px;
                            Text {
                                text: "Iniciar servicio gdsyncd con el sistema";
                                font-size: 13px;
                                font-weight: 500;
                                color: Theme.text-main;
                            }
                            Text {
                                text: "Habilita la unidad systemd gdsyncd.service a nivel de usuario";
                                font-size: 12px;
                                color: Theme.text-secondary;
                            }
                        }
                        SwitchToggle {
                            checked <=> root.autostart-daemon;
                        }
                    }

                    HorizontalLayout {
                        alignment: space-between;
                        VerticalLayout {
                            spacing: 2px;
                            Text {
                                text: "Permanecer en la bandeja al cerrar con la 'X'";
                                font-size: 13px;
                                font-weight: 500;
                                color: Theme.text-main;
                            }
                            Text {
                                text: "Si está desactivado, el proceso GUI se cierra por completo";
                                font-size: 12px;
                                color: Theme.text-secondary;
                            }
                        }
                        SwitchToggle {
                            checked <=> root.close-to-tray;
                        }
                    }

                    HorizontalLayout {
                        alignment: space-between;
                        VerticalLayout {
                            spacing: 2px;
                            Text {
                                text: "Notificaciones de escritorio del sistema";
                                font-size: 13px;
                                font-weight: 500;
                                color: Theme.text-main;
                            }
                            Text {
                                text: "Avisar cuando se completen subidas o cuando la cuota esté casi llena";
                                font-size: 12px;
                                color: Theme.text-secondary;
                            }
                        }
                        SwitchToggle {
                            checked <=> root.notify-enabled;
                        }
                    }

                    HorizontalLayout {
                        alignment: space-between;
                        VerticalLayout {
                            spacing: 2px;
                            Text {
                                text: "Notificación residente durante subidas";
                                font-size: 13px;
                                font-weight: 500;
                                color: Theme.text-main;
                            }
                            Text {
                                text: "Muestra una tarjeta fija en el panel KDE/GNOME mientras se suben archivos";
                                font-size: 12px;
                                color: Theme.text-secondary;
                            }
                        }
                        SwitchToggle {
                            checked <=> root.resident-notify;
                        }
                    }
                }
            }

            // Maintenance Zone Card
            Rectangle {
                background: Theme.bg-card;
                border-radius: Theme.radius-lg;
                border-width: 1px;
                border-color: Theme.danger.transparentize(0.7);

                VerticalLayout {
                    padding: 20px;
                    spacing: 12px;

                    HorizontalLayout {
                        spacing: 8px;
                        alignment: start;
                        Text { text: "⚠️"; font-size: 15px; vertical-alignment: center; }
                        Text {
                            text: "Zona de Mantenimiento";
                            font-size: 14px;
                            font-weight: 600;
                            color: Theme.danger;
                            vertical-alignment: center;
                        }
                    }

                    Text {
                        text: "Si tenés inconsistencias de sincronización o querés limpiar la base de datos local y la caché:";
                        font-size: 12px;
                        color: Theme.text-secondary;
                    }

                    HorizontalLayout {
                        alignment: start;
                        Rectangle {
                            border-radius: Theme.radius-sm;
                            background: touch_resync.has-hover ? #dc2626 : Theme.danger;
                            height: 32px;
                            HorizontalLayout {
                                padding-left: 14px;
                                padding-right: 14px;
                                spacing: 6px;
                                Text { text: "🧹"; font-size: 12px; vertical-alignment: center; }
                                Text { text: "Restablecer base de datos y caché (Resync)"; font-size: 12px; font-weight: 600; color: white; vertical-alignment: center; }
                            }
                            touch_resync := TouchArea {
                                mouse-cursor: pointer;
                                clicked => { root.confirm-resync(); }
                            }
                        }
                    }
                }
            }
        }
    }
}
